# ── Firebase ───────────────────────────────────────────────────────────────
# Use a NEW Firebase project for this app (not KeyGo's).
# Locally: download a service-account key (Firebase console → Project settings →
# Service accounts → Generate new private key), save it in this folder as
# firebase-service-account.json, and leave this line as it is.
FIREBASE_SERVICE_ACCOUNT_FILE=./firebase-service-account.json

# On a host like Vercel, use this instead of the file (run `npm run firebase:env` to print it):
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Your Firebase project ID (shown in Project settings), e.g. aimex-reports
FIREBASE_PROJECT_ID=

# ── Sign-in ────────────────────────────────────────────────────────────────
# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string

# Your admin login. Created when you run `npm run setup`.
# Put the password in double quotes if it contains # or spaces.
ADMIN_EMAIL=you@aimexstudio.com
ADMIN_PASSWORD="change-this-password"
